# Variables de entorno (se configuran en la plataforma de despliegue; el servidor no lee archivos .env)
PORT=3000
DB_PATH=/data/reparared.db      # ruta del archivo SQLite; debe estar en un disco persistente
SEED_DEMO=0                     # 0 = base vacía (por defecto); 1 = cargar datos de ejemplo solo para pruebas
ADMIN_EMAIL=admin@reparared.demo
ADMIN_PASSWORD=admin1234        # cambia esto en producción
